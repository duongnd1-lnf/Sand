#pragma kernel Advance
#pragma kernel Render
#pragma kernel ConsumeTail

#define SHADES 8

RWStructuredBuffer<uint> Buf;       // [lane * Length + p]
RWTexture2D<float4> Result;         // Length x Lanes
float4 Palette[16 * SHADES];
float4 EmptyColor;

int Length;
int Lanes;

RWStructuredBuffer<int> ConsumeCounter; // [0] = count, [1] = capacity
int AcceptType;

// Mỗi thread xử lý 1 lane: duyệt từ cuối về đầu để cả đoàn hạt dịch 1 ô cùng lúc.
[numthreads(64, 1, 1)]
void Advance(uint3 id : SV_DispatchThreadID)
{
    int lane = (int)id.x;
    if (lane >= Lanes)
        return;

    uint b = (uint)lane * (uint)Length;

    for (int p = Length - 2; p >= 0; p--)
    {
        uint v = Buf[b + p];
        if (v != 0 && Buf[b + p + 1] == 0)
        {
            Buf[b + p + 1] = v;
            Buf[b + p] = 0;
        }
    }
}

[numthreads(64, 1, 1)]
void ConsumeTail(uint3 id : SV_DispatchThreadID)
{
    int lane = (int)id.x;
    if (lane >= Lanes)
        return;

    uint tail = (uint)lane * (uint)Length + (uint)(Length - 1);
    uint v = Buf[tail];
    if (v == 0)
        return;

    uint type = v & 15u;
    if (AcceptType > 0 && (int)type != AcceptType)
        return;

    int prev;
    InterlockedAdd(ConsumeCounter[0], 1, prev);
    if (prev >= ConsumeCounter[1])
    {
        InterlockedAdd(ConsumeCounter[0], -1);
        return;
    }

    Buf[tail] = 0;
}

[numthreads(8, 8, 1)]
void Render(uint3 id : SV_DispatchThreadID)
{
    if ((int)id.x >= Length || (int)id.y >= Lanes)
        return;

    uint v = Buf[id.y * Length + id.x];
    uint type = v & 15u;

    if (type == 0)
    {
        Result[id.xy] = EmptyColor;
    }
    else
    {
        uint shade = (v >> 4) & (SHADES - 1);
        Result[id.xy] = Palette[type * SHADES + shade];
    }
}
