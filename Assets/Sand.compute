#pragma kernel ClearAll
#pragma kernel ClearClaims
#pragma kernel Simulate
#pragma kernel Render
#pragma kernel Erase

#define SHADES 8

// Current frame data (read-only during simulation)
RWStructuredBuffer<uint> Current;
// Next frame data (write target)
RWStructuredBuffer<uint> Next;
// Atomic claim buffer: 0 = unclaimed, 1 = claimed
RWStructuredBuffer<uint> Claims;

RWTexture2D<float4> Result;
float4 Palette[16 * SHADES];

int Width;
int Height;
int Frame;

int EraseXMin;
int EraseXMax;
int EraseYMin;
int EraseYMax;
int EraseType;

// Atomically claim a cell. Returns true if this thread was first to claim it.
bool AtomicClaim(int x, int y)
{
    uint index = (uint)y * Width + (uint)x;
    uint previous;
    InterlockedCompareExchange(Claims[index], 0u, 1u, previous);
    return previous == 0u;
}

[numthreads(8, 8, 1)]
void ClearAll(uint3 id : SV_DispatchThreadID)
{
    if ((int)id.x >= Width || (int)id.y >= Height)
        return;

    uint index = id.y * Width + id.x;
    Current[index] = 0u;
    Next[index]    = 0u;
    Claims[index]  = 0u;
}

[numthreads(8, 8, 1)]
void ClearClaims(uint3 id : SV_DispatchThreadID)
{
    if ((int)id.x >= Width || (int)id.y >= Height)
        return;

    Claims[id.y * Width + id.x] = 0u;
}

[numthreads(8, 8, 1)]
void Simulate(uint3 id : SV_DispatchThreadID)
{
    int x = (int)id.x;
    int y = (int)id.y;

    // Border cells stay still (matches reference: id.y <= 0 || id.y >= Height || id.x <= 0 || id.x >= Width-1)
    if (x <= 0 || x >= Width - 1 || y <= 0 || y >= Height)
        return;

    uint index = (uint)y * Width + (uint)x;
    uint value = Current[index];

    // Empty cell - nothing to do
    if ((value & 15u) == 0u)
        return;

    bool oddFrame = (Frame & 1) == 1;

    // Alternate diagonal preference each frame
    int2 down       = int2(x,     y - 1);
    int2 diagFirst  = oddFrame ? int2(x + 1, y - 1) : int2(x - 1, y - 1);
    int2 diagSecond = oddFrame ? int2(x - 1, y - 1) : int2(x + 1, y - 1);

    // Try straight down
    if (Current[(uint)down.y * Width + (uint)down.x] == 0u && AtomicClaim(down.x, down.y))
    {
        Next[index]                                = 0u;
        Next[(uint)down.y * Width + (uint)down.x] = value;
        return;
    }

    // Try first diagonal
    if (diagFirst.x >= 0 && diagFirst.x < Width &&
        Current[(uint)diagFirst.y * Width + (uint)diagFirst.x] == 0u &&
        AtomicClaim(diagFirst.x, diagFirst.y))
    {
        Next[index] = 0u;
        Next[(uint)diagFirst.y * Width + (uint)diagFirst.x] = value;
        return;
    }

    // Try second diagonal
    if (diagSecond.x >= 0 && diagSecond.x < Width &&
        Current[(uint)diagSecond.y * Width + (uint)diagSecond.x] == 0u &&
        AtomicClaim(diagSecond.x, diagSecond.y))
    {
        Next[index] = 0u;
        Next[(uint)diagSecond.y * Width + (uint)diagSecond.x] = value;
        return;
    }
}

[numthreads(8, 8, 1)]
void Render(uint3 id : SV_DispatchThreadID)
{
    if ((int)id.x >= Width || (int)id.y >= Height)
        return;

    uint value = Current[id.y * Width + id.x];
    uint type  = value & 15u;
    uint shade = (value >> 4) & (SHADES - 1);

    Result[id.xy] = Palette[type * SHADES + shade];
}

[numthreads(8, 8, 1)]
void Erase(uint3 id : SV_DispatchThreadID)
{
    int x = EraseXMin + (int)id.x;
    int y = EraseYMin + (int)id.y;

    if (x > EraseXMax || y > EraseYMax || x < 0 || x >= Width || y < 0 || y >= Height)
        return;

    uint index = (uint)y * Width + (uint)x;
    uint val = Current[index];
    if (val != 0u && (EraseType <= 0 || (int)(val & 15u) == EraseType))
    {
        Current[index] = 0u;
        Next[index]    = 0u;
    }
}
